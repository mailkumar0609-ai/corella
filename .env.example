# Copy to .env and fill in. Never commit .env.
CORELLA_ENV=production

# Database (Postgres in production; SQLite file is used if unset)
DATABASE_URL=postgresql+psycopg://user:password@host:5432/corella

# LLM: anthropic | openai | mock
CORELLA_LLM=anthropic
CORELLA_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
CORELLA_LLM_TIMEOUT=120
CORELLA_LLM_RETRIES=3

# Limits and safety
CORELLA_MAX_SCENARIOS=200
CORELLA_ALLOW_PRIVATE_TARGETS=false
CORELLA_WORKER_POLL=2

# Comma-separated origins allowed to call the API from a browser (your dashboard)
CORELLA_CORS_ORIGINS=https://app.corella.live
